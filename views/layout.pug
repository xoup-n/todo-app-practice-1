doctype html
html(lang="uk")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title
      block title
        | To-Do List
    //- Notyf (сповіщення) через CDN
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    style.
      body { font-family: Arial, sans-serif; background: #f4f6f8; margin: 0; }
      header { background: #2c5282; color: #fff; padding: 16px 32px; }
      main { max-width: 640px; margin: 24px auto; background: #fff;
             padding: 24px 32px; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.15); }
      footer { text-align: center; color: #718096; font-size: 13px; padding: 16px; }
      ul { list-style: none; padding: 0; }
      li { padding: 10px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; }
      .title { flex: 1; }
      li.completed .title { text-decoration: line-through; color: #718096; }
      .badge { display: none; background: #38a169; color: #fff; font-size: 12px;
               padding: 2px 8px; border-radius: 10px; margin: 0 8px; }
      li.completed .badge { display: inline-block; }
      form { display: flex; gap: 8px; margin-bottom: 16px; }
      input[type=text] { flex: 1; padding: 8px 10px; border: 1px solid #cbd5e0; border-radius: 4px; font-size: 15px; }
      button { padding: 8px 14px; border: none; border-radius: 4px; cursor: pointer;
               background: #2c5282; color: #fff; font-size: 14px; }
      button.btn { padding: 4px 10px; margin-left: 6px; font-size: 12px; }
      button.remove { background: #e53e3e; }
  body
    header
      h1 To-Do List
    main
      block content
    footer
      | ПЗ №6 · Express.js + Pug + Joi + Notyf · МНАУ
    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    block scripts
